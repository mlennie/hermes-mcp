# --- REQUIRED -----------------------------------------------------------------
#
# Static OAuth 2.1 confidential-client credentials used by Claude Desktop /
# Claude.ai's Custom Connector (or any MCP client that supports a static
# client_id + client_secret) to authenticate against this bridge. The
# client_secret is ENFORCED at /token — treat it as a password. Generate a
# fresh pair with:
#   hermes-mcp mint-client
# Paste the same values into your Claude connector (Advanced settings).
# Codex / Cursor only support public (PKCE-only) OAuth clients and must use
# MCP_BEARER_TOKEN below instead.

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Public HTTPS URL where this server is reachable (your tunnel hostname).
# Used as the OAuth issuer and to derive the resource-server URL.
# Must be HTTPS, except http://localhost is allowed for local testing.
OAUTH_ISSUER_URL=

# Bearer token for the local Hermes Agent gateway's OpenAI-compatible API
# (the `API_SERVER_KEY` value from ~/.hermes/.env).
HERMES_API_KEY=

# --- OPTIONAL -----------------------------------------------------------------

# Base URL of the Hermes gateway. Default: http://127.0.0.1:8642
# HERMES_API_URL=http://127.0.0.1:8642

# Model identifier for /v1/chat/completions. Default: hermes-agent
# HERMES_MODEL=hermes-agent

# Bind address. Default 127.0.0.1 — your tunnel (cloudflared/ngrok) reaches it.
# Do NOT bind to 0.0.0.0 unless you understand the implications.
# BIND_HOST=127.0.0.1

# Port. Default 8765.
# BIND_PORT=8765

# Max wall-clock seconds for a single hermes_ask call. Default 300.
# HERMES_REQUEST_TIMEOUT_SECONDS=300

# Comma-separated list of additional Host header values to accept (typically
# your public tunnel hostname). 127.0.0.1, localhost, and ::1 are always
# allowed. MCP's DNS-rebinding protection uses this list.
# MCP_ALLOWED_HOSTS=hermes.example.com

# Comma-separated list of the EXACT OAuth redirect URIs /authorize may send
# a code to. Each must be https:// (or http://localhost for testing). Setting
# this REPLACES the default, so keep Claude's callbacks if you use Claude.
# Default:
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
#
# OAUTH_ALLOWED_REDIRECT_SCHEMES is deprecated and ignored (a startup warning
# is logged if it is set). Remove it.

# Optional static bearer token. When set, the server accepts
# `Authorization: Bearer <token>` directly at /mcp, in addition to the
# OAuth flow. Use this for MCP clients whose UI has no OAuth flow or that
# only support public (PKCE-only) OAuth clients — Codex (desktop and CLI),
# Cursor's `headers` block, etc.
# Generate with: hermes-mcp mint-bearer-token
# OAuth-based clients (Claude Desktop / Claude.ai) keep working unchanged.
# Bearer tokens are long-lived shared secrets; min 32 chars enforced.
# MCP_BEARER_TOKEN=

# Log level (DEBUG / INFO / WARNING / ERROR / CRITICAL). Default INFO.
# DEBUG enables logging of full prompt bodies — leave at INFO unless debugging.
# LOG_LEVEL=INFO
